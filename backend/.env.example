# Copy this file to .env and fill in your values
# Get these from your Supabase project → Settings → API

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Generate a strong random string — used to sign JWT tokens
JWT_SECRET=change-this-to-a-long-random-secret-string

PORT=5000
NODE_ENV=development

# ── Meta Webhook ─────────────────────────────────────────────────────────────
# Choose any random string — paste this same value into Meta App Dashboard
# when configuring the webhook (Verify Token field).
WEBHOOK_VERIFY_TOKEN=your-custom-verify-token

# ── WhatsApp Business API ─────────────────────────────────────────────────────
# developers.facebook.com → Your App → WhatsApp → API Setup
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id

# ── Facebook Messenger ────────────────────────────────────────────────────────
# developers.facebook.com → Your App → Messenger → Configuration
FACEBOOK_PAGE_ACCESS_TOKEN=your_page_access_token
FACEBOOK_PAGE_ID=your_page_id

# ── Instagram Messaging ───────────────────────────────────────────────────────
# developers.facebook.com → Your App → Instagram → Configuration
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token
INSTAGRAM_BUSINESS_ID=your_instagram_business_account_id
